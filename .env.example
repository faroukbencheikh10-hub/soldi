# --- Trade della settimana (nessuna chiave nuova: riusa quelle già in uso) ---
# Modello AI già usato dall'intraday. Default modulo settimana: gpt-5.6-luna
OPENAI_MODEL=
# Buffer $ applicato solo allo SL del trade settimanale (default 0.70)
SPREAD_BUFFER=0.70
# Stesso secret del cron intraday. Endpoint nuovo:
# GET /api/cron/settimana?secret=...  ogni ora su cron-job.org (lun–ven)
CRON_SECRET=
